{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "baseUrl": ".",
    "paths": {
      "aemeath-js": ["./src/index.ts"],
      "aemeath-js/parser": ["./src/parser/index.ts"],
      "aemeath-js/core/Logger": ["./src/core/Logger.ts"],
      "aemeath-js/plugins/*": ["./src/plugins/*"],
      "aemeath-js/crash-worker": ["./src/crash-worker.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "examples/9-before-send/*.ts",
    "examples/11-crash-detection/*.ts",
    "examples/10-offline-resilience/*.ts",
    "examples/recommended-config.ts",
    "examples/1-error-capture/with-evidence.ts",
    "examples/3-sourcemap-parser/with-evidence.ts",
    "examples/3-sourcemap-parser/basic.ts",
    "examples/1-error-capture/with-webview-enhanced.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-miniprogram"]
}
